# Local configuration and credentials
.env
.env.*
!.env.example

# Dependencies, caches and locally built tools
node_modules/
__pycache__/
*.py[cod]
.local-bin/

# Generated analysis output
/output/
*.path2d
.deobf-write-*/
coverage/

# Devirtualizer intermediates (regenerated on every run)
samples/output/**/*.protos.json
samples/output/**/*.devirt.luau
samples/output/**/*.deobf.luau

# Source material stays local (big, and re-uploaded often); results are tracked,
# because a deobfuscation nobody can open is not a result.
samples/input/**
!samples/input/.gitkeep
!samples/input/*/.gitkeep

# The root-level Luraph fixtures the integration tests use are inputs too.
/samples/*_obfuscated.lua
