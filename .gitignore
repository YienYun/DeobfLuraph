# Local configuration and credentials
.env
.env.*
!.env.example

# Dependencies, caches and locally built tools
node_modules/
__pycache__/
*.py[cod]
.local-bin/

# Generated analysis output (scratch). The delivered pair in output/current/ is
# tracked on purpose: the numbers in TECHNICAL.md have to stay checkable against
# the exact file they were measured on.
/output/*
!/output/current/
*.path2d
.deobf-write-*/
coverage/

# Test fixtures: third-party samples fetched by blob id and verified by sha256
# (fixtures/manifest.json pins them). Never committed -- 9 MB of other people's
# binaries do not belong in this repository.
/dev/fixtures/input/

# Deobfuscation intermediates (regenerated on every run, never committed)
*.protos.json
*.devirt.luau
*.deobf.luau
*.chunk_*.luau
*.union.json

# Regenerated fixture outputs (written by dev/scripts/fixtures.js)
/dev/fixtures/output/
