							local value9, value10, value11 = ipairs(workspace.PetsPhysical:GetChildren())
							for _, value12 in value10, value11 do
								local name = localPlayer.Name
								if value12:GetAttribute("OWNER") == name then
									gameEvents.PetsService:FireServer("UnequipPet", value12:GetAttribute("UUID"))
								end
							end
							task.wait(0.5)
							local value12, value13, value14 = ipairs(selectFile2)
							for _, value15 in value13, value14 do
								gameEvents.PetsService:FireServer("EquipPet", value15, localPlayer.Character.HumanoidRootPart.CFrame)
								table.insert(list, value15)
