# Local configuration and credentials
.env
.env.*
!.env.example

# Dependencies, caches and locally built tools
node_modules/
__pycache__/
*.py[cod]
.local-bin/

# Generated analysis output
/output/
*.path2d
.deobf-write-*/
coverage/

# Devirtualizer intermediates (regenerated on every run)
samples/output/**/*.protos.json
samples/output/**/*.devirt.luau
samples/output/**/*.deobf.luau

# Working corpus: layout is tracked, files are not (samples/README.md)
samples/input/**
!samples/input/.gitkeep
!samples/input/*/.gitkeep
samples/output/**
!samples/output/.gitkeep
