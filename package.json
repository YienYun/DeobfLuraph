{
  "name": "deobfluraph",
  "version": "1.0.0",
  "description": "Luraph v15.0 & v15.1 Luau Deobfuscator Engine",
  "main": "deob.js",
  "bin": {
    "deob": "./deob.js",
    "luau-rename": "./renamer/index.js"
  },
  "scripts": {
    "start": "node deob.js",
    "rename": "node renamer/index.js",
    "fixtures": "node scripts/fixtures.js fetch",
    "fixtures:verify": "node scripts/fixtures.js verify",
    "golden": "node scripts/update-golden.js",
    "check": "node scripts/check.js",
    "test": "node scripts/check.js && node --test test/watermark.test.js test/detect.test.js test/diagnostics.test.js test/engines.test.js test/fixtures.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:all": "node scripts/check.js && node --test test/",
    "metrics": "python3 scripts/metrics.py"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "luraph",
    "deobfuscator",
    "roblox",
    "luau"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@johnnymorganz/stylua-bin": "^2.6.0",
    "fengari": "^0.1.5",
    "luaparse": "^0.3.1",
    "smart-buffer": "^4.2.0",
    "unicode-substring": "^1.0.0"
  }
}
