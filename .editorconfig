root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{lua,luau}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{package-lock.json,fixtures/manifest.json,test/golden.json}]
indent_size = 2
insert_final_newline = true
