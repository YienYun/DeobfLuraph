		local number10 = tonumber(match)
		if not number10 then
			return nil
		end
		return number10
			* (({ K = 1000, M = 1000000, B = 1e9, T = 1e12 })[string.upper(match2)] or 1)
	end

	local function formatCompact3(argument)
		if argument >= 1e12 then
			return string.format("$%.2fT/s", argument / 1e12)
		end

		if argument >= 1e9 then
			return string.format("$%.2fB/s", argument / 1e9)
		end

		if argument >= 1000000 then
			return string.format("$%.2fM/s", argument / 1000000)
		end

		if argument >= 1000 then
